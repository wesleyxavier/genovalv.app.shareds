#Ambiente de desenvolvimento genérico — New/Shareds
COMPOSE_PROJECT_NAME=genova-new
DOCKER_VOLUMES_ROOT=C:/Docker-Volumes

# Auth0 Proxy
# Preencha com as credenciais do seu tenant/aplicação Auth0 antes de autenticar.
AUTH0_PORT=3010
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_CALLBACK_URL=https://admin.genova.localhost:3010/api/auth/callback
AUTH0_RETURN_URL=/
AUTH0_SESSION_SECRET=genova-dev-session-secret

# Proxy de borda local (simula Cloudflare) — specs 002 & 010
# Simulação de desenvolvimento: NÃO é equivalente ao Cloudflare real.
EDGE_BASE_DOMAIN=genova.localhost
EDGE_HTTP_PORT=8080
EDGE_HTTPS_PORT=3010
EDGE_UPSTREAM_PLAYGROUND=host.docker.internal:4173
EDGE_UPSTREAM_ADMIN=host.docker.internal:3103
EDGE_UPSTREAM_ERP=host.docker.internal:3101
EDGE_UPSTREAM_FACTORYFLOOR=host.docker.internal:3102
EDGE_RATE_LIMIT_RPS=100
EDGE_RATE_LIMIT_BURST=200
EDGE_CF_COUNTRY=BR
EDGE_CF_COLO=GRU
EDGE_CERT_DAYS=825
EDGE_DATA_DIR=C:/Docker-Volumes/genova/new-edge
EDGE_ECHO_PORT=9100
