#Ambiente de desenvolvimento genérico — New/
COMPOSE_PROJECT_NAME=genova-new
DOCKER_VOLUMES_ROOT=C:/Docker-Volumes

# PostgreSQL 17
POSTGRES_PORT=5433
POSTGRES_USER=genovadmin
POSTGRES_PASSWORD=genova_dev_pass
POSTGRES_DB=GenovaIADB

# Auth0 Proxy (yannj/auth0-docker)
# Preencha com as credenciais do seu tenant/aplicação Auth0 antes de autenticar.
AUTH0_PORT=3010
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_CALLBACK_URL=http://localhost:3010/callback
AUTH0_RETURN_URL=/
AUTH0_SESSION_SECRET=genova-dev-session-secret
